# =============================================================
# 多机 vLLM 部署环境变量模板
#
# 用法：cp deploy/.env.example deploy/.env 后按实际环境修改
# 注意：docker compose 会自动读取同目录下的 .env
# =============================================================

# ---------- 镜像 ----------
# 与 deploy/Dockerfile 构建出的镜像 tag 保持一致
VLLM_IMAGE=grpo-vllm:v0.8.5

# ---------- 模型（可填 HF repo id 或本地目录） ----------
# 部署训练产物示例：MODEL_PATH=./output/grpo-countdown（需挂载进容器）
MODEL_PATH=Qwen/Qwen2.5-3B-Instruct
SERVED_MODEL_NAME=qwen2.5-3b
# 模型权重 dtype：auto / bfloat16 / float16
DTYPE=auto
# 最大上下文长度（超过会报错；显存不足时调小）
MAX_MODEL_LEN=4096
# 单卡显存占用比例（多实例同卡部署时需下调）
GPU_MEMORY_UTILIZATION=0.9
# 单实例最大并发序列数
MAX_NUM_SEQS=256

# ---------- 并行策略 ----------
# 模式 A（多实例 + 负载均衡）：TP_SIZE = 单节点 GPU 数，PP_SIZE=1，DISTRIBUTED_BACKEND=mp
# 模式 B（单实例跨节点）    ：TP_SIZE x PP_SIZE = 集群总 GPU 数，DISTRIBUTED_BACKEND=ray
TP_SIZE=1
PP_SIZE=1
DISTRIBUTED_BACKEND=mp

# ---------- 服务 ----------
PORT=8000
HOST=0.0.0.0
# 留空则不鉴权；设置后客户端需带 Authorization: Bearer <API_KEY>
API_KEY=
# 追加给 vllm serve 的额外参数，例如 "--enable-prefix-caching --quantization awq"
EXTRA_ARGS=

# ---------- 模型缓存（挂载宿主机目录，避免各节点重复下载） ----------
HF_HOME=${HOME}/.cache/huggingface
HF_ENDPOINT=https://hf-mirror.com

# ---------- 多机节点清单（模式 A 用，逗号分隔；需 SSH 免密可达） ----------
# 例：NODES=worker1,worker2,worker3
NODES=worker1,worker2
# 各节点 vLLM 服务端口（Nginx upstream 用）
NODE_PORT=8000
# 容器内可见的本地模型目录（可选）：MODEL_PATH 为相对路径时挂载进容器
# 例：MODEL_DIR=./output/grpo-countdown
MODEL_DIR=
# 容器共享内存大小（多卡 TP 必需，默认 16g）
SHM_SIZE=16g

# ---------- 负载均衡（Nginx） ----------
NGINX_PORT=8080
# 分发策略：least_conn（最小连接，推荐）/ round_robin / ip_hash（会话保持）
NGINX_LB_METHOD=least_conn

# ---------- Ray 集群（模式 B 用） ----------
RAY_HEAD_NODE=worker1
RAY_PORT=6379
RAY_DASHBOARD_PORT=8265

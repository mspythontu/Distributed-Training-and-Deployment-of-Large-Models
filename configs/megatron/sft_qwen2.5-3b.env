# =============================================================
# Megatron-LM SFT 监督微调参数（Qwen2.5-3B-Instruct）
#
# 加载方式：由 scripts/megatron/sft_qwen.sh 以 source 方式读入
# 用法：bash scripts/megatron/sft_qwen.sh --conf configs/megatron/sft_qwen2.5-3b.env
#
# 与预训练的差异要点：
#   - 学习率显著降低（1e-5 ~ 2e-5），避免破坏预训练知识
#   - 迭代步数少、warmup 占比更高
#   - 数据必须是 input/output 分离的 SFT 格式（由 prepare_sft_data.py --mode sft 产出）
# =============================================================

# ---------- 数据 ----------
DATA_PATH="data/megatron/countdown_sft"

# ---------- 模型架构（与预训练保持一致） ----------
NUM_LAYERS=36
HIDDEN_SIZE=2048
FFN_HIDDEN_SIZE=11008
NUM_ATTN_HEADS=16
NUM_QUERY_GROUPS=2
MAX_POSITION_EMBEDDINGS=32768
ROTARY_BASE=1000000
NORM_EPSILON=1e-6
SEQLEN=1024                       # 需覆盖 prompt + answer 的总长度
TOKENIZER_PATH="Qwen/Qwen2.5-3B-Instruct"

# ---------- 并行策略 ----------
TP=1
PP=1
CP=1
EP=1
SEQ_PARALLEL=1

# ---------- 训练超参（SFT 典型值） ----------
MBS=2
GBS=32
LR=1e-5                           # SFT 学习率约为预训练的 1/10 ~ 1/20
MIN_LR=1e-6
LR_DECAY_STYLE="cosine"
LR_WARMUP_FRAC=0.03               # SFT warmup 占比略高，训练更稳
WEIGHT_DECAY=0.0                  # SFT 通常关闭权重衰减
ADAM_BETA1=0.9
ADAM_BETA2=0.95
CLIP_GRAD=1.0
TRAIN_ITERS=1000
EVAL_INTERVAL=100
SAVE_INTERVAL=200
LOG_INTERVAL=10

# ---------- 精度与性能 ----------
BF16=1
USE_FLASH_ATTN=1
TRANSFORMER_IMPL="transformer_engine"

# ---------- 路径 ----------
SAVE_DIR="output/megatron/sft"
# 建议从 convert_checkpoint.py 转换出的 Mcore 检查点起步；
# 留空则从随机初始化开始（仅用于跑通流程，不建议实际使用）
LOAD_DIR=""
EXTRA_ARGS=""

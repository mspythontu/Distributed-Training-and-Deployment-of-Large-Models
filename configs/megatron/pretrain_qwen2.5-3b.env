# =============================================================
# Megatron-LM 预训练 / 继续预训练参数（Qwen2.5-3B-Instruct）
#
# 加载方式：由 scripts/megatron/pretrain_qwen.sh 以 source 方式读入
# 用法：bash scripts/megatron/pretrain_qwen.sh --conf configs/megatron/pretrain_qwen2.5-3b.env
#
# 注意：本文件为纯 bash 赋值语法，等号两侧不能有空格
# =============================================================

# ---------- 数据 ----------
# bin/idx 数据前缀（不带 _xxx.bin 后缀），由 scripts/megatron/prepare_sft_data.py 产出
DATA_PATH="data/megatron/countdown_pt"

# ---------- 模型架构（必须与 checkpoint 一致，否则权重维度不匹配） ----------
# Qwen2.5-3B-Instruct 官方配置
NUM_LAYERS=36                     # transformer 层数
HIDDEN_SIZE=2048                  # 隐藏维度
FFN_HIDDEN_SIZE=11008             # FFN 中间层维度（SwiGLU）
NUM_ATTN_HEADS=16                 # 注意力头数
NUM_QUERY_GROUPS=2                # GQA 分组数（16 头共享 2 组 KV）
MAX_POSITION_EMBEDDINGS=32768     # 最大位置编码长度
ROTARY_BASE=1000000               # RoPE theta，Qwen2 系列为 1e6（务必核对）
NORM_EPSILON=1e-6                 # RMSNorm eps
SEQLEN=1024                       # 训练序列长度

# 分词器：HF 模型 id 或本地目录；国内网络可先下载后填本地路径
TOKENIZER_PATH="Qwen/Qwen2.5-3B-Instruct"

# ---------- 并行策略（未显式指定时脚本会按 GPU 数自动推荐） ----------
TP=1                              # 张量并行（建议限制在单节点 NVLink 内）
PP=1                              # 流水线并行（跨机或装不下时启用）
CP=1                              # 上下文并行（长序列场景）
EP=1                              # 专家并行（仅 MoE，稠密模型保持 1）
SEQ_PARALLEL=1                    # 序列并行：TP>1 时强烈建议开启以降低激活显存

# ---------- 训练超参（预训练典型值） ----------
MBS=4                             # micro batch size：单卡单次前向样本数
GBS=64                            # global batch size：一个优化步的全局样本数
LR=3e-4                           # 3B 模型预训练常用学习率
MIN_LR=3e-5
LR_DECAY_STYLE="cosine"
LR_WARMUP_FRAC=0.01               # warmup 占比（预训练）
WEIGHT_DECAY=0.1
ADAM_BETA1=0.9
ADAM_BETA2=0.95
CLIP_GRAD=1.0
TRAIN_ITERS=10000
EVAL_INTERVAL=500
SAVE_INTERVAL=1000
LOG_INTERVAL=10

# ---------- 精度与性能 ----------
BF16=1                            # 1=bf16 混合精度（推荐）
USE_FLASH_ATTN=1                  # 1=启用 FlashAttention（需 Hopper/A100+）
TRANSFORMER_IMPL="transformer_engine"   # 或 local（未装 TE 时用 local）

# ---------- 路径 ----------
SAVE_DIR="output/megatron/pretrain"
LOAD_DIR=""                       # 继续预训练：填 convert_checkpoint.py 产出的 Mcore 检查点
EXTRA_ARGS=""                     # 追加给 pretrain_gpt.py 的额外参数，例如 "--profile"
